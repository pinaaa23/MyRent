rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthAndVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Koleksi users/{userId}: Hanya pemilik UID itu sendiri yang boleh membaca/menulis
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Koleksi toko/{userId}/...: Hanya pemilik UID itu sendiri dengan email terverifikasi yang boleh membaca/menulis
    match /toko/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && isAuthAndVerified();
    }

    // Koleksi cabang (legacy): Hanya dibaca publik, ditulis oleh pengguna terverifikasi
    match /cabang/{cabangId} {
      allow read: if true;
      allow write: if isAuthAndVerified();
    }
  }
}
