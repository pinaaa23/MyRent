<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyRent" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#171513</item>
        <item name="android:navigationBarColor">#171513</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- SplashScreen API Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#171513</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_myrent_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.MyRent</item>
    </style>
</resources>
